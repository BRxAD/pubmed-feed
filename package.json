{
  "name": "pubmed-feed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "import:jcr": "tsx scripts/import_jcr.ts",
    "ingest:now": "tsx scripts/run-ingest-now.ts",
    "ingest:openalex": "tsx scripts/run-openalex-ingest-now.ts",
    "ingest:ai-stewardship": "tsx scripts/run-ai-stewardship-initial-ingest.ts",
    "retrain:priority": "tsx --tsconfig scripts/priority-eval/tsconfig.json scripts/retrain-priority-model.ts",
    "eval:priority": "tsx --tsconfig scripts/priority-eval/tsconfig.json scripts/priority-eval/export-dataset.ts",
    "recompute:rank-scores": "tsx --env-file=.env.local scripts/recompute-rank-scores.ts",
    "backfill:ml-priority": "tsx --tsconfig scripts/priority-eval/tsconfig.json --env-file=.env.local scripts/backfill-ml-priority-handcrafted.ts",
    "backfill:auto-settings": "tsx --env-file=.env.local scripts/backfill-auto-settings.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "fast-xml-parser": "^5.3.7",
    "next": "^16.2.11",
    "openai": "^6.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
